# Copy this file to .env and fill in real values. Never commit .env.

# TMDB (The Movie Database) API key — free, self-serve signup at themoviedb.org/settings/api.
# Used to resolve show/episode metadata (titles, runtimes, IDs).
TMDB_API_KEY=

# "Does the Dog Die" API key — free, self-serve signup at doesthedogdie.com.
# Used to pull crowdsourced content-warning topic data (series/season scope, no timestamps).
DTDD_API_KEY=

# SubDL API key — free, self-serve signup at subdl.com.
# Used to search/download subtitle files for the subtitle-scan pipeline.
SUBDL_API_KEY=

# OpenSubtitles API key — free, self-serve signup at opensubtitles.com/en/consumers.
# Used to search/download subtitle files for the subtitle-scan pipeline.
OPENSUBTITLES_API_KEY=

# OpenSubtitles account username — required in addition to the API key for downloads (login is
# required to actually fetch subtitle files, not just search).
OPENSUBTITLES_USERNAME=

# OpenSubtitles account password — see OPENSUBTITLES_USERNAME above.
OPENSUBTITLES_PASSWORD=
